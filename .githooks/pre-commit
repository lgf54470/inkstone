#!/bin/sh
# Pre-commit gate for AGENTS.md policy checks (mirrors the CI static policy
# gates so violations fail locally before reaching CI).
set -e
cd "$(git rev-parse --show-toplevel)"

# Static policy gates — always on (fast, whole-tree by design). Parity with
# the CI static block (i18n/comments/escape/module-state/deep-imports/size);
# the build/budget/vendor/e2e steps remain CI-only (slow or server-bound).
node scripts/check-size.mjs
node scripts/check-comments.mjs
node scripts/check-escape-hatches.mjs
node scripts/check-empty-catches.mjs
node scripts/check-hardcoded.mjs
node scripts/check-token-drift.mjs
node scripts/check-i18n.mjs
node scripts/check-module-state.mjs
node scripts/check-deep-imports.mjs
node scripts/check-code-style.mjs

# Type/test gates — scoped to the staged TypeScript files so local commits
# stay fast; the full suite still runs in CI. `tsc -b` is incremental (via
# .tsbuildinfo it only re-checks the modules affected by this change), and
# vitest "related" runs only the unit tests that import the staged files.
staged_ts="$(git diff --cached --name-only --diff-filter=ACM -- '*.ts' '*.tsx')"
if [ -z "$staged_ts" ]; then
  exit 0
fi

npm run typecheck --silent

# shellcheck disable=SC2086  # word-splitting is intended for the file list
npx --no-install vitest related $staged_ts --passWithNoTests
