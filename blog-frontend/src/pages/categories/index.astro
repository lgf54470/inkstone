---
import Layout from '../../layouts/Layout.astro'
import { api } from '../../lib/api'
import { categoryDotStyle } from '../../lib/category-style'
import { t, DEFAULT_LOCALE, type BlogLocale } from '../../lib/i18n'

const locale: BlogLocale = Astro.locals?.locale ?? DEFAULT_LOCALE
const categories = await api.getCategories()
---

<Layout
  title={t('category.index_title', {}, locale)}
  description={t('category.index_description', {}, locale)}
  locale={locale}
  fitViewport={true}
>
  <div class="max-w-3xl mx-auto space-y-8 py-2 sm:py-4">
    <header class="text-center py-6 border-b border-[var(--border-subtle)] space-y-2">
      <h1 class="text-2xl sm:text-3xl font-extrabold text-[var(--text-primary)]">
        {t('category.index_header', {}, locale)}
      </h1>
      <p class="text-xs text-[var(--text-tertiary)]">
        {t('category.index_intro', { count: categories.length }, locale)}
      </p>
    </header>

    {categories.length === 0 ? (
      <div class="py-16 text-center text-xs text-[var(--text-tertiary)]">
        {t('category.empty', {}, locale)}
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {categories.map((cat) => (
          <a
            href={`/categories/${cat.slug}`}
            class="group p-5 rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] hover:border-[var(--accent)] hover:shadow-[var(--shadow-hover)] transition-all flex flex-col justify-between"
          >
            <div class="space-y-2">
              <div class="flex items-center gap-2.5">
                <span
                  class="w-3 h-3 rounded-full shrink-0 shadow-2xs"
                  style={categoryDotStyle(cat.color)}
                />
                <h2 class="font-bold text-base text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors">
                  {cat.name}
                </h2>
              </div>
              {cat.description && (
                <p class="text-xs text-[var(--text-secondary)] line-clamp-2 leading-relaxed">
                  {cat.description}
                </p>
              )}
            </div>

            <div class="pt-4 mt-3 border-t border-[var(--border-subtle)]/50 flex items-center justify-between text-xs text-[var(--text-tertiary)]">
              <span>{t('category.posts_unit', { count: cat.postsCount || 0 }, locale)}</span>
              <span class="group-hover:translate-x-1 group-hover:text-[var(--accent)] transition-transform">
                {t('category.browse', {}, locale)}
              </span>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</Layout>
