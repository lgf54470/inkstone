---
import Layout from '../../layouts/Layout.astro'
import PostCard from '../../components/PostCard.astro'
import Pagination from '../../components/Pagination.astro'
import { api } from '../../lib/api'
import { categoryDotStyle } from '../../lib/category-style'
import { t, DEFAULT_LOCALE, type BlogLocale } from '../../lib/i18n'

const locale: BlogLocale = Astro.locals?.locale ?? DEFAULT_LOCALE
const slug = Astro.params.slug
if (!slug) {
  return Astro.redirect('/404')
}

const [categories, siteInfo] = await Promise.all([api.getCategories(), api.getSiteInfo()])
const category = categories.find((c) => c.slug === slug)

if (!category) {
  return Astro.redirect('/404')
}

const url = Astro.url
const page = parseInt(url.searchParams.get('page') || '1', 10)

// 分页大小与首页保持一致，遵循站点配置的 postsPerPage 而非硬编码 10
const postsData = await api.getPosts({ categoryId: category.id, page, limit: siteInfo.postsPerPage })
---

<Layout title={`${category.name} - ${siteInfo.siteName || 'Inkstone Blog'}`} description={category.description} siteInfo={siteInfo} locale={locale}>
  <div class="max-w-4xl mx-auto space-y-8">
    <header class="py-6 border-b border-[var(--border-subtle)] space-y-3">
      <a href="/categories" class="text-xs text-[var(--accent)] hover:underline inline-flex items-center gap-1">
        {t('category.back_to_all', {}, locale)}
      </a>
      <div class="flex items-center gap-3">
        <span
          class="w-4 h-4 rounded-full shadow-2xs"
          style={categoryDotStyle(category.color)}
        />
        <h1 class="text-2xl sm:text-3xl font-extrabold text-[var(--text-primary)]">
          {category.name}
        </h1>
        <span class="text-xs px-2.5 py-0.5 rounded-full bg-[var(--bg-sunken)] text-[var(--text-tertiary)]">
          {t('category.posts_count', { count: postsData.total }, locale)}
        </span>
      </div>
      {category.description && (
        <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
          {category.description}
        </p>
      )}
    </header>

    {postsData.posts.length === 0 ? (
      <div class="py-16 text-center text-xs text-[var(--text-tertiary)]">
        {t('category.no_posts', {}, locale)}
      </div>
    ) : (
      <div class="space-y-4">
        {postsData.posts.map((post) => (
          <PostCard post={post} category={category} locale={locale} />
        ))}
      </div>
    )}

    <Pagination currentPage={postsData.page} totalPages={postsData.totalPages} baseUrl={`/categories/${category.slug}`} locale={locale} />
  </div>
</Layout>
