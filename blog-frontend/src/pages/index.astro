---
import Layout from '../layouts/Layout.astro'
import HomeFeedView from '../components/home/HomeFeedView'
import { api } from '../lib/api'
import { DEFAULT_LOCALE, type BlogLocale } from '../lib/i18n'

const locale: BlogLocale = Astro.locals?.locale ?? DEFAULT_LOCALE

// Query params
const url = Astro.url
const page = Math.max(1, parseInt(url.searchParams.get('page') || '1', 10))
const limitParam = parseInt(url.searchParams.get('limit') || '10', 10)
const limit = Math.min(50, Math.max(1, Number.isNaN(limitParam) ? 10 : limitParam))
const tag = url.searchParams.get('tag') || null

// Parallel data fetching for SSR
const [siteInfo, postsData, categories, tags, calendarDays] = await Promise.all([
  api.getSiteInfo(),
  api.getPosts({ page, limit, tag: tag ?? undefined }),
  api.getCategories(),
  api.getTags(),
  api.getCalendar(),
])
---

<Layout title={`${siteInfo.siteName} - ${siteInfo.subtitle}`} description={siteInfo.bio} siteInfo={siteInfo} locale={locale} fitViewport={true}>
  <HomeFeedView
    client:load
    initialPosts={postsData.posts}
    initialTotal={postsData.total}
    initialPage={postsData.page}
    initialLimit={postsData.limit}
    initialTotalPages={postsData.totalPages}
    categories={categories}
    tags={tags}
    calendarDays={calendarDays}
    siteInfo={siteInfo}
    locale={locale}
    initialTag={tag}
  />
</Layout>
