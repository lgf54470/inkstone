---
import Layout from '../layouts/Layout.astro'
import HomeFeedView from '../components/home/HomeFeedView'
import { api } from '../lib/api'
import { parsePositiveInt } from '../lib/pagination'
import { DEFAULT_LOCALE, type BlogLocale } from '../lib/i18n'

const locale: BlogLocale = Astro.locals?.locale ?? DEFAULT_LOCALE

// Query params：非法值回退默认，避免 NaN 进请求
const url = Astro.url
const page = parsePositiveInt(url.searchParams.get('page'), 1)
const limit = Math.min(50, parsePositiveInt(url.searchParams.get('limit'), 10))
const tag = url.searchParams.get('tag') || null

// Parallel data fetching for SSR
const [siteInfo, postsData, categories, tags, calendarDays] = await Promise.all([
  api.getSiteInfo(),
  api.getPosts({ page, limit, tag: tag ?? undefined }),
  api.getCategories(),
  api.getTags(),
  api.getCalendar(),
])
---

<Layout
  title={`${siteInfo.siteName} - ${siteInfo.subtitle}`}
  description={siteInfo.bio}
  siteInfo={siteInfo}
  locale={locale}
  fitViewport={true}
  scrollableMain={false}
>
  <HomeFeedView
    client:load
    initialPosts={postsData.posts}
    initialTotal={postsData.total}
    initialPage={postsData.page}
    initialLimit={postsData.limit}
    initialTotalPages={postsData.totalPages}
    categories={categories}
    tags={tags}
    calendarDays={calendarDays}
    siteInfo={siteInfo}
    locale={locale}
    initialTag={tag}
  />
</Layout>
