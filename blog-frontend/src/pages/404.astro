---
import Layout from '../layouts/Layout.astro'
import { t, DEFAULT_LOCALE, type BlogLocale } from '../lib/i18n'

const locale: BlogLocale = Astro.locals?.locale ?? DEFAULT_LOCALE
---

<Layout title={t('not_found.title', {}, locale)} locale={locale}>
  <div class="py-24 text-center space-y-4 max-w-md mx-auto">
    <div class="w-16 h-16 rounded-2xl bg-[var(--accent-softer)] text-[var(--accent)] font-bold text-2xl flex items-center justify-center mx-auto shadow-[var(--shadow-xs)]">
      404
    </div>
    <h1 class="text-2xl font-bold text-[var(--text-primary)]">
      {t('not_found.heading', {}, locale)}
    </h1>
    <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
      {t('not_found.desc', {}, locale)}
    </p>
    <div class="pt-4">
      <a
        href="/"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[var(--accent)] text-white text-xs font-semibold hover:opacity-90 transition-opacity shadow-[var(--shadow-xs)]"
      >
        {t('not_found.back_home', {}, locale)}
      </a>
    </div>
  </div>
</Layout>
