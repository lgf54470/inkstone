---
import Layout from '../../layouts/Layout.astro'
import PostCard from '../../components/PostCard.astro'
import Pagination from '../../components/Pagination.astro'
import { api } from '../../lib/api'
import { safeDecodeTag } from '../../lib/content'
import { t, DEFAULT_LOCALE, type BlogLocale } from '../../lib/i18n'

const locale: BlogLocale = Astro.locals?.locale ?? DEFAULT_LOCALE
const rawTag = Astro.params.tag
if (!rawTag) {
  return Astro.redirect('/tags')
}
const tagName = safeDecodeTag(rawTag)
if (!tagName) {
  return Astro.redirect('/tags')
}

const url = Astro.url
const page = parseInt(url.searchParams.get('page') || '1', 10)

// 分页大小与首页保持一致，遵循站点配置的 postsPerPage 而非硬编码 10
const [siteInfo, categories] = await Promise.all([api.getSiteInfo(), api.getCategories()])
const postsData = await api.getPosts({ tag: tagName, page, limit: siteInfo.postsPerPage })

const categoryMap = new Map(categories.map((c) => [c.id, c]))
---

<Layout title={`#${tagName} - ${siteInfo.siteName || 'Inkstone Blog'}`} description={`#${tagName}`} siteInfo={siteInfo} locale={locale}>
  <div class="max-w-4xl mx-auto space-y-8">
    <header class="py-6 border-b border-[var(--border-subtle)] space-y-3">
      <a href="/tags" class="text-xs text-[var(--accent)] hover:underline inline-flex items-center gap-1">
        {t('tag.back_to_all', {}, locale)}
      </a>
      <div class="flex items-center gap-3">
        <h1 class="text-2xl sm:text-3xl font-extrabold text-[var(--text-primary)]">
          #{tagName}
        </h1>
        <span class="text-xs px-2.5 py-0.5 rounded-full bg-[var(--bg-sunken)] text-[var(--text-tertiary)]">
          {t('tag.posts_count', { count: postsData.total }, locale)}
        </span>
      </div>
    </header>

    {postsData.posts.length === 0 ? (
      <div class="py-16 text-center text-xs text-[var(--text-tertiary)]">
        {t('tag.no_posts', {}, locale)}
      </div>
    ) : (
      <div class="space-y-4">
        {postsData.posts.map((post) => (
          <PostCard post={post} category={post.categoryId ? categoryMap.get(post.categoryId) : undefined} locale={locale} />
        ))}
      </div>
    )}

    <Pagination currentPage={postsData.page} totalPages={postsData.totalPages} baseUrl={`/tags/${encodeURIComponent(tagName)}`} locale={locale} />
  </div>
</Layout>
