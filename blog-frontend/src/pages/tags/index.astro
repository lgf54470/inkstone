---
import Layout from '../../layouts/Layout.astro'
import { api } from '../../lib/api'
import { POPULAR_TAG_MIN_POSTS } from '../../lib/constants'
import { t, DEFAULT_LOCALE, type BlogLocale } from '../../lib/i18n'

const locale: BlogLocale = Astro.locals?.locale ?? DEFAULT_LOCALE
const tags = await api.getTags()
---

<Layout
  title={t('tag.index_title', {}, locale)}
  description={t('tag.index_description', {}, locale)}
  locale={locale}
  fitViewport={true}
>
  <div class="max-w-3xl mx-auto space-y-8 py-2 sm:py-4">
    <header class="text-center py-6 border-b border-[var(--border-subtle)] space-y-2">
      <h1 class="text-2xl sm:text-3xl font-extrabold text-[var(--text-primary)]">
        {t('tag.index_header', {}, locale)}
      </h1>
      <p class="text-xs text-[var(--text-tertiary)]">
        {t('tag.index_intro', { count: tags.length }, locale)}
      </p>
    </header>

    {tags.length === 0 ? (
      <div class="py-16 text-center text-xs text-[var(--text-tertiary)]">
        {t('tag.empty', {}, locale)}
      </div>
    ) : (
      <div class="p-8 rounded-3xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] flex flex-wrap gap-2.5 items-center justify-center">
        {tags.map((tItem) => {
          // Scale size slightly based on count
          const isPopular = tItem.postsCount > POPULAR_TAG_MIN_POSTS
          return (
            <a
              href={`/tags/${encodeURIComponent(tItem.name)}`}
              class={`group inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-base)] hover:border-[var(--accent)] hover:bg-[var(--accent-softer)] transition-all ${
                isPopular ? 'font-bold text-sm text-[var(--accent)]' : 'text-xs text-[var(--text-secondary)]'
              }`}
            >
              <span>#{tItem.name}</span>
              <span class="text-[10px] px-1.5 py-0.2 rounded-full bg-[var(--bg-sunken)] text-[var(--text-tertiary)] group-hover:text-[var(--accent)]">
                {tItem.postsCount}
              </span>
            </a>
          )
        })}
      </div>
    )}
  </div>
</Layout>
