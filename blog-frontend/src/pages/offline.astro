---
import Layout from '../layouts/Layout.astro'
import { DEFAULT_LOCALE, t, type BlogLocale } from '../lib/i18n'

const locale: BlogLocale = Astro.locals?.locale ?? DEFAULT_LOCALE
---

<Layout title={t('offline.title', {}, locale)} locale={locale} noindex>
  <div class="max-w-xl mx-auto py-20 text-center space-y-4">
    <h1 class="text-2xl font-extrabold text-[var(--text-primary)]">
      {t('offline.title', {}, locale)}
    </h1>
    <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
      {t('offline.hint', {}, locale)}
    </p>
    <a
      href="/"
      class="inline-block px-4 py-2 rounded-lg bg-[var(--accent)] text-white text-sm font-medium hover:opacity-90 transition-opacity"
    >
      {t('offline.home', {}, locale)}
    </a>
  </div>
</Layout>
