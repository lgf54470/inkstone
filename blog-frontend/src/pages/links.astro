---
import Layout from '../layouts/Layout.astro'
import { LinksContainer } from '../components/links/links-container'
import { api, fetchPublicLinks } from '../lib/api'
import { t, DEFAULT_LOCALE, type BlogLocale } from '../lib/i18n'

const locale: BlogLocale = Astro.locals?.locale ?? DEFAULT_LOCALE
const siteInfo = await api.getSiteInfo()
const data = await fetchPublicLinks()
---

<Layout
  title={t('links.title', {}, locale)}
  description={t('links.description', {}, locale)}
  locale={locale}
  siteInfo={siteInfo}
  fitViewport={true}
>
  <LinksContainer
    client:load
    initialLinks={data.links}
    categories={data.categories}
    siteName={siteInfo.siteName || 'Inkstone Blog'}
    siteUrl={siteInfo.socialLinks?.website}
    siteDescription={siteInfo.bio || siteInfo.subtitle}
    siteAvatar={siteInfo.authorAvatar}
  />
</Layout>
