---
import Layout from '../../layouts/Layout.astro'
import CommentsSection from '../../components/CommentsSection'
import { api } from '../../lib/api'
import { renderMarkdown } from '../../lib/markdown'
import { isSvgCoverUrl, stripFrontmatter } from '../../lib/content'
import type { BlogCategory } from '../../lib/types'
import { WORDS_PER_MINUTE } from '../../lib/constants'

const slug = Astro.params.slug
if (!slug) {
  return Astro.redirect('/404')
}

const forwardHeaders: Record<string, string> = {}
const clientIp = Astro.clientAddress || Astro.request.headers.get('x-forwarded-for')
if (clientIp) forwardHeaders['x-forwarded-for'] = clientIp
const ua = Astro.request.headers.get('user-agent')
if (ua) forwardHeaders['user-agent'] = ua
const referer = Astro.request.headers.get('referer')
if (referer) forwardHeaders['referer'] = referer
const country = Astro.request.headers.get('cf-ipcountry')
if (country) forwardHeaders['cf-ipcountry'] = country
const region = Astro.request.headers.get('cf-region')
if (region) forwardHeaders['cf-region'] = region
const city = Astro.request.headers.get('cf-city')
if (city) forwardHeaders['cf-city'] = city

const post = await api.getPostBySlug(slug, forwardHeaders)
if (!post) {
  return Astro.redirect('/404')
}

// Strip leading frontmatter from content if present
const rawContent = post.content || ''
let bodyContent = stripFrontmatter(rawContent)

// Check if first non-empty line is an H1 matching post.title to avoid duplicate H1
const leadingH1Match = bodyContent.trimStart().match(/^#\s+(.+?)(?:\r?\n|$)/)
if (leadingH1Match && leadingH1Match[1].trim() === post.title.trim()) {
  const h1Full = leadingH1Match[0]
  const startIndex = bodyContent.indexOf(h1Full)
  bodyContent = bodyContent.slice(0, startIndex) + bodyContent.slice(startIndex + h1Full.length)
}

// Render markdown content
const { html, headings } = renderMarkdown(bodyContent)

// Get Category
let category: BlogCategory | undefined
if (post.categoryId) {
  const categories = await api.getCategories()
  category = categories.find((c) => c.id === post.categoryId)
}

const formattedDate = new Date(post.publishedAt || post.createdAt).toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})

// Estimated reading time based on Chinese chars per minute
const wordCount = bodyContent.replace(/\s+/g, '').length
const readingMinutes = Math.max(1, Math.round(wordCount / WORDS_PER_MINUTE))
---

<Layout title={`${post.title} - Inkstone Blog`} description={post.excerpt} coverUrl={post.coverUrl}>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    {/* Main Article Content */}
    <main class={`space-y-8 ${headings.length > 0 ? 'lg:col-span-9' : 'lg:col-span-12'}`}>
      <!-- Article Header -->
      <header class="space-y-4 pb-6 border-b border-[var(--border-subtle)]">
        {/* Category & Date */}
        <div class="flex items-center gap-2.5 flex-wrap">
          {category && (
            <a
              href={`/categories/${category.slug}`}
              class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold border border-[var(--border-subtle)] hover:border-[var(--accent)] transition-colors"
              style={category.color ? { color: category.color, borderColor: `${category.color}40` } : undefined}
            >
              {category.name}
            </a>
          )}
          <time class="text-xs text-[var(--text-quaternary)]">
            发布于 {formattedDate}
          </time>
          <span class="text-[var(--text-quaternary)]">•</span>
          <span class="text-xs text-[var(--text-quaternary)]">
            约 {wordCount} 字 / 阅读需 {readingMinutes} 分钟
          </span>
          {typeof post.views === 'number' && (
            <>
              <span class="text-[var(--text-quaternary)]">•</span>
              <span class="text-xs text-[var(--text-quaternary)]">
                {post.views} 次浏览
              </span>
            </>
          )}
        </div>

        {/* Title */}
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-[var(--text-primary)] leading-tight">
          {post.title}
        </h1>

        {/* Tags */}
        {post.tags && post.tags.length > 0 && (
          <div class="flex items-center gap-2 flex-wrap pt-2">
            {post.tags.map((tag) => (
              <a
                href={`/tags/${encodeURIComponent(tag)}`}
                class="px-2.5 py-1 rounded-lg text-xs bg-[var(--bg-sunken)] hover:bg-[var(--accent-softer)] text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors"
              >
                #{tag}
              </a>
            ))}
          </div>
        )}
      </header>

      {/* Featured Cover Image */}
      {post.coverUrl && (
        <div class="rounded-2xl overflow-hidden border border-[var(--border-subtle)] shadow-sm bg-[var(--bg-sunken)] w-full flex items-center justify-center">
          <img
            src={post.coverUrl}
            alt={post.title}
            class={
              isSvgCoverUrl(post.coverUrl)
                ? "max-h-48 w-auto object-contain p-6"
                : "max-h-96 w-full object-cover"
            }
          />
        </div>
      )}

      {/* 100% Identical Note Preview Style Article Body */}
      <article class="ink-prose max-w-none pt-2 pb-0" set:html={html} />

      {/* Article End Card & Share */}
      <div class="p-6 rounded-2xl bg-[var(--bg-sunken)] border border-[var(--border-subtle)] flex flex-col sm:flex-row items-center justify-between gap-4 my-8">
        <div class="space-y-1 text-center sm:text-left">
          <h4 class="text-sm font-bold text-[var(--text-primary)]">
            感谢阅读本文
          </h4>
          <p class="text-xs text-[var(--text-tertiary)]">
            本文内容由 Inkstone 笔记系统发布并驱动，欢迎在下方发表交流与讨论。
          </p>
        </div>
        <div class="flex items-center gap-2">
          <button
            type="button"
            onclick="navigator.clipboard.writeText(window.location.href); alert('文章链接已复制到剪贴板！');"
            class="px-3.5 py-1.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] hover:bg-[var(--bg-hover)] text-xs text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors flex items-center gap-1.5 cursor-pointer shadow-2xs"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            <span>分享链接</span>
          </button>
        </div>
      </div>

      {/* Comments Section */}
      <CommentsSection client:visible postId={post.id} allowComments={post.allowComments} />
    </main>

    {/* Floating Table of Contents (TOC) Sidebar */}
    {headings.length > 0 && (
      <aside class="hidden lg:block lg:col-span-3 sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto space-y-3 p-4 rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-xs">
        <h3 class="font-bold text-xs uppercase tracking-wider text-[var(--text-primary)] pb-2 border-b border-[var(--border-subtle)]">
          文章目录
        </h3>
        <nav class="space-y-1">
          {headings.map((h) => (
            <a
              href={`#${h.slug}`}
              class={`block py-1 hover:text-[var(--accent)] text-[var(--text-secondary)] transition-colors line-clamp-1 ${
                h.level === 1
                  ? 'font-semibold pl-0'
                  : h.level === 2
                  ? 'pl-2'
                  : h.level === 3
                  ? 'pl-4 text-[var(--text-tertiary)]'
                  : 'pl-6 text-[var(--text-quaternary)]'
              }`}
            >
              {h.text}
            </a>
          ))}
        </nav>
      </aside>
    )}
  </div>

  <script>
    import { initInteractiveContent } from '../../lib/interactive'
    initInteractiveContent()
  </script>
</Layout>
