---
import Layout from '../layouts/Layout.astro'
import CalendarWidget from '../components/CalendarWidget'
import { api } from '../lib/api'
import { t, DEFAULT_LOCALE, type BlogLocale } from '../lib/i18n'

const locale: BlogLocale = Astro.locals?.locale ?? DEFAULT_LOCALE
const calendarDays = await api.getCalendar()
---

<Layout title={t('calendar.title', {}, locale)} description={t('calendar.description', {}, locale)} locale={locale}>
  <div class="max-w-4xl mx-auto space-y-8">
    <!-- Header -->
    <header class="text-center py-6 border-b border-[var(--border-subtle)] space-y-2">
      <h1 class="text-2xl sm:text-3xl font-extrabold text-[var(--text-primary)]">
        {t('calendar.header_title', {}, locale)}
      </h1>
      <p class="text-xs text-[var(--text-tertiary)]">
        {t('calendar.intro', {}, locale)}
      </p>
    </header>

    <!-- Full Calendar Component -->
    <section class="py-4">
      <CalendarWidget client:load initialDays={calendarDays} isFullPage={true} initialLocale={locale} />
    </section>

    <!-- Description & Tips -->
    <div class="p-6 rounded-2xl bg-[var(--bg-sunken)] border border-[var(--border-subtle)] text-xs text-[var(--text-secondary)] leading-relaxed space-y-2 max-w-2xl mx-auto text-center">
      <h3 class="font-bold text-sm text-[var(--text-primary)]">{t('calendar.tips_title', {}, locale)}</h3>
      <p>
        {t('calendar.tips_desc', {}, locale)}
      </p>
    </div>
  </div>
</Layout>
