---
import { buildPageItems, getPageUrl } from '../lib/pagination'
import { t, DEFAULT_LOCALE, type BlogLocale } from '../lib/i18n'

interface Props {
  currentPage: number
  totalPages: number
  baseUrl?: string
  locale?: BlogLocale
}

const { currentPage, totalPages, baseUrl = '', locale: propLocale } = Astro.props
const locale: BlogLocale = propLocale ?? Astro.locals?.locale ?? DEFAULT_LOCALE

if (totalPages <= 1) return null

const cleanedPages = buildPageItems(currentPage, totalPages)
const pageUrl = (p: number) => getPageUrl(p, baseUrl)
---

<nav class="flex items-center justify-center gap-1.5 my-10" aria-label={t('pagination.aria', {}, locale)}>
  <!-- Prev -->
  {currentPage > 1 ? (
    <a
      href={pageUrl(currentPage - 1)}
      class="px-3 py-1.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] hover:bg-[var(--bg-hover)] text-xs text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors flex items-center gap-1"
    >
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      <span>{t('pagination.prev', {}, locale)}</span>
    </a>
  ) : (
    <span class="px-3 py-1.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-xs text-[var(--text-quaternary)] opacity-50 cursor-not-allowed flex items-center gap-1">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      <span>{t('pagination.prev', {}, locale)}</span>
    </span>
  )}

  <!-- Pages -->
  {cleanedPages.map((p) => {
    if (p === '...') {
      return (
        <span class="px-2 py-1.5 text-xs text-[var(--text-tertiary)]">...</span>
      )
    }
    const isCurrent = p === currentPage
    return (
      <a
        href={pageUrl(p as number)}
        class={`w-8 h-8 rounded-lg text-xs font-medium flex items-center justify-center transition-all ${
          isCurrent
            ? 'bg-[var(--accent)] text-white shadow-[var(--shadow-xs)] font-bold'
            : 'border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:bg-[var(--bg-hover)] hover:text-[var(--text-primary)]'
        }`}
        aria-current={isCurrent ? 'page' : undefined}
      >
        {p}
      </a>
    )
  })}

  <!-- Next -->
  {currentPage < totalPages ? (
    <a
      href={pageUrl(currentPage + 1)}
      class="px-3 py-1.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] hover:bg-[var(--bg-hover)] text-xs text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors flex items-center gap-1"
    >
      <span>{t('pagination.next', {}, locale)}</span>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  ) : (
    <span class="px-3 py-1.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-xs text-[var(--text-quaternary)] opacity-50 cursor-not-allowed flex items-center gap-1">
      <span>{t('pagination.next', {}, locale)}</span>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </span>
  )}
</nav>
