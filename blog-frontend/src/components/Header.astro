---
import { t, DEFAULT_LOCALE, type BlogLocale } from '../lib/i18n'

interface Props {
  siteName: string
  locale?: BlogLocale
}

const { siteName, locale: propLocale } = Astro.props
const locale: BlogLocale = propLocale ?? Astro.locals?.locale ?? DEFAULT_LOCALE

const navItems = [
  { label: t('nav.home', {}, locale), href: '/' },
  { label: t('nav.timeline', {}, locale), href: '/timeline' },
  { label: t('nav.calendar', {}, locale), href: '/calendar' },
  { label: t('nav.categories', {}, locale), href: '/categories' },
  { label: t('nav.tags', {}, locale), href: '/tags' },
  { label: t('nav.links', {}, locale), href: '/links' },
]

const currentPath = Astro.url.pathname
---

<header class="sticky top-0 z-40 w-full border-b border-[var(--border-subtle)] bg-[var(--bg-base)]/85 backdrop-blur-md transition-colors">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 h-15 flex items-center justify-between gap-4">
    <!-- Brand Logo -->
    <a href="/" data-astro-prefetch="viewport" class="flex items-center gap-2.5 group">
      <div class="w-8 h-8 rounded-lg bg-[var(--accent)] text-white flex items-center justify-center font-serif font-bold text-base shadow-[var(--shadow-xs)] group-hover:scale-105 transition-transform">
        墨
      </div>
      <div class="flex flex-col">
        <span class="font-bold text-sm tracking-tight text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors">
          {siteName}
        </span>
        <span class="text-[10px] text-[var(--text-quaternary)] leading-none">
          Inkstone & Astro
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1">
      {navItems.map((item) => {
        const isActive = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href)
        return (
          <a
            href={item.href}
            data-astro-prefetch="viewport"
            class={`px-3 py-1.5 rounded-lg text-xs font-medium transition-colors ${
              isActive
                ? 'bg-[var(--accent-softer)] text-[var(--accent)] font-semibold'
                : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-hover)]'
            }`}
          >
            {item.label}
          </a>
        )
      })}
    </nav>

    <!-- Action Tools -->
    <div class="flex items-center gap-1.5 sm:gap-2">
      <!-- Search Button -->
      <button
        type="button"
        id="btn-open-search"
        class="flex items-center gap-2 px-2.5 py-1.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] hover:bg-[var(--bg-hover)] text-xs text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all cursor-pointer shadow-2xs"
        aria-label={t('nav.search_aria', {}, locale)}
      >
        <svg class="w-3.5 h-3.5 text-[var(--text-tertiary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span class="hidden sm:inline text-xs text-[var(--text-tertiary)]">{t('nav.search_placeholder', {}, locale)}</span>
        <kbd class="hidden sm:inline-block text-[10px] font-mono px-1 py-0.2 rounded border border-[var(--border-subtle)] bg-[var(--bg-base)] text-[var(--text-quaternary)]">
          ⌘K
        </kbd>
      </button>

      <!-- Appearance Settings Button -->
      <button
        type="button"
        id="btn-open-appearance"
        class="p-2 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] hover:bg-[var(--bg-hover)] text-[var(--text-secondary)] hover:text-[var(--accent)] transition-all cursor-pointer shadow-2xs"
        title={t('nav.appearance_settings', {}, locale)}
        aria-label={t('nav.appearance_aria', {}, locale)}
      >
        <svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
        </svg>
      </button>

      <!-- Mobile Menu Toggle Button -->
      <button
        type="button"
        id="btn-toggle-mobile-menu"
        class="md:hidden p-2 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] hover:bg-[var(--bg-hover)] text-[var(--text-secondary)] transition-all cursor-pointer"
        aria-label={t('nav.mobile_menu_toggle', {}, locale)}
        aria-expanded="false"
        aria-controls="mobile-nav-panel"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-nav-panel" class="hidden md:hidden border-t border-[var(--border-subtle)] bg-[var(--bg-raised)] px-4 py-3 space-y-1">
    {navItems.map((item) => (
      <a
        href={item.href}
        data-astro-prefetch="viewport"
        class="block px-3 py-2 rounded-lg text-xs font-medium text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-hover)]"
      >
        {item.label}
      </a>
    ))}
  </div>
</header>

<script>
  // Search button trigger
  document.getElementById('btn-open-search')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-search-modal'))
  })

  // Appearance drawer trigger
  document.getElementById('btn-open-appearance')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-appearance-drawer'))
  })

  // Mobile menu toggle: 同步 aria-expanded，点击外部或按 Escape 时关闭
  const mobileBtn = document.getElementById('btn-toggle-mobile-menu')
  const mobilePanel = document.getElementById('mobile-nav-panel')
  const closeMobileMenu = () => {
    mobilePanel?.classList.add('hidden')
    mobileBtn?.setAttribute('aria-expanded', 'false')
  }
  mobileBtn?.addEventListener('click', (e) => {
    e.stopPropagation()
    const isOpen = mobilePanel?.classList.toggle('hidden') === false
    mobileBtn?.setAttribute('aria-expanded', String(isOpen))
  })
  document.addEventListener('click', (e) => {
    if (mobilePanel?.contains(e.target as Node) || mobileBtn?.contains(e.target as Node)) return
    closeMobileMenu()
  })
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMobileMenu()
  })
</script>
