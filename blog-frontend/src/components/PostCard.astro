---
import type { BlogPost, BlogCategory } from '../lib/types'
import { isSvgCoverUrl } from '../lib/content'

interface Props {
  post: BlogPost
  category?: BlogCategory
}

const { post, category } = Astro.props

const formattedDate = new Date(post.publishedAt || post.createdAt).toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
---

<article class="group relative flex flex-col sm:flex-row gap-5 p-5 rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] hover:border-[var(--accent-muted)] hover:shadow-md transition-all duration-200">
  {/* Cover Image */}
  {post.coverUrl ? (
    <a
      href={`/posts/${post.slug}`}
      class="sm:w-48 sm:h-36 w-full h-44 shrink-0 rounded-xl overflow-hidden bg-[var(--bg-sunken)] relative flex items-center justify-center"
      tabindex="-1"
      aria-hidden="true"
    >
      <img
        src={post.coverUrl}
        alt={post.title}
        loading="lazy"
        class={
          isSvgCoverUrl(post.coverUrl)
            ? "w-auto h-auto max-w-[80%] max-h-[80%] object-contain p-2 group-hover:scale-105 transition-transform duration-300"
            : "w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        }
      />
    </a>
  ) : null}

  {/* Content Details */}
  <div class="flex-1 flex flex-col justify-between">
    <div>
      {/* Meta header (Category & Pinned) */}
      <div class="flex items-center gap-2 mb-2 flex-wrap">
        {post.isPinned && (
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-[var(--accent)] text-white shadow-2xs">
            置顶
          </span>
        )}
        {category && (
          <a
            href={`/categories/${category.slug}`}
            class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-medium border border-[var(--border-subtle)] hover:border-[var(--accent)] transition-colors"
            style={category.color ? { color: category.color, borderColor: `${category.color}40` } : undefined}
          >
            {category.name}
          </a>
        )}
        <time class="text-xs text-[var(--text-quaternary)]">
          {formattedDate}
        </time>
      </div>

      {/* Post Title */}
      <h3 class="text-lg font-bold text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors line-clamp-2 mb-2 leading-snug">
        <a href={`/posts/${post.slug}`}>
          {post.title}
        </a>
      </h3>

      {/* Excerpt */}
      {post.excerpt && (
        <p class="text-xs sm:text-sm text-[var(--text-secondary)] line-clamp-2 leading-relaxed mb-3">
          {post.excerpt}
        </p>
      )}
    </div>

    {/* Post Footer: Tags & Stats */}
    <div class="flex items-center justify-between gap-4 pt-2 border-t border-[var(--border-subtle)]/50 text-xs text-[var(--text-tertiary)] flex-wrap">
      {/* Tags */}
      <div class="flex items-center gap-1.5 flex-wrap">
        {post.tags && post.tags.slice(0, 3).map((tag) => (
          <a
            href={`/tags/${encodeURIComponent(tag)}`}
            class="px-2 py-0.5 rounded-md text-[11px] bg-[var(--bg-sunken)] hover:bg-[var(--accent-softer)] hover:text-[var(--accent)] transition-colors"
          >
            #{tag}
          </a>
        ))}
      </div>

      {/* Stats */}
      <div class="flex items-center gap-3 text-[11px] text-[var(--text-quaternary)] shrink-0">
        {typeof post.views === 'number' && (
          <span class="flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
            {post.views}
          </span>
        )}
        {typeof post.commentsCount === 'number' && (
          <span class="flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
            {post.commentsCount}
          </span>
        )}
      </div>
    </div>
  </div>
</article>
