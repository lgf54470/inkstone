---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import AppearanceDrawer from '../components/AppearanceDrawer'
import SearchModal from '../components/SearchModal'
import DegradedBanner from '../components/DegradedBanner'
import { api, getApiBase } from '../lib/api'
import type { BlogSiteInfo } from '../lib/types'
import { DEFAULT_LOCALE, type BlogLocale } from '../lib/i18n'

interface ArticleMeta {
  title: string
  description?: string
  coverUrl?: string | null
  publishedAt?: number
  updatedAt?: number
  url?: string
}

interface Props {
  title?: string
  description?: string
  coverUrl?: string | null
  siteInfo?: BlogSiteInfo
  locale?: BlogLocale
  fitViewport?: boolean
  articleMeta?: ArticleMeta
}

const {
  title = 'Inkstone Blog',
  description = '基于 Inkstone 与 Astro 驱动的高品质静态博客系统',
  coverUrl,
  siteInfo: propSiteInfo,
  locale: propLocale,
  fitViewport = false,
  articleMeta,
} = Astro.props


const locale: BlogLocale = propLocale ?? Astro.locals?.locale ?? DEFAULT_LOCALE

// 站点信息在布局层只取一次并下发 Header/Footer，避免每请求 2–3 次重复请求
const siteInfo = propSiteInfo ?? (await api.getSiteInfo())
---

<!doctype html>
<html lang={locale} data-theme="light" data-accent="cinnabar" data-background="paper" data-density="comfortable">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${siteInfo.siteName} RSS`} href="/feed.xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {coverUrl && <meta property="og:image" content={coverUrl} />}
    <meta name="inkstone-api-url" content={getApiBase()} />
    <meta name="inkstone-locale" content={locale} />
    <link rel="canonical" href={`${Astro.url.origin}${Astro.url.pathname}`} />
    {articleMeta && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: articleMeta.title,
        description: articleMeta.description || undefined,
        image: articleMeta.coverUrl || undefined,
        datePublished: articleMeta.publishedAt ? new Date(articleMeta.publishedAt).toISOString() : undefined,
        dateModified: articleMeta.updatedAt ? new Date(articleMeta.updatedAt).toISOString() : undefined,
        author: { '@type': 'Person', name: siteInfo.authorName },
        url: articleMeta.url || undefined,
      })} />
    )}

    <!-- 语言切换整页刷新后恢复滚动位置（一次性读取，正常导航无影响） -->
    <script is:inline>
      ;(function () {
        try {
          const key = 'inkstone-blog-scroll-restore'
          const y = sessionStorage.getItem(key)
          if (y !== null) {
            sessionStorage.removeItem(key)
            window.addEventListener('load', () => window.scrollTo(0, Number(y)), { once: true })
          }
        } catch (e) {
          console.warn('Failed to restore scroll position:', e)
        }
      })()
    </script>

    <!-- Immediately apply theme preferences before paint to prevent flicker -->
    <script is:inline define:vars={{ initialLocale: locale }}>
      ;(function () {
        try {
          const raw = localStorage.getItem('inkstone-blog-appearance')
          const cfg = raw ? JSON.parse(raw) : {}
          const theme = cfg.theme || 'system'
          const resolvedTheme =
            theme === 'system'
              ? window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light'
              : theme
          const doc = document.documentElement
          doc.setAttribute('data-theme', resolvedTheme)
          doc.setAttribute('data-accent', cfg.accent || 'cinnabar')
          doc.setAttribute('data-background', cfg.background || 'paper')
          doc.setAttribute('data-density', cfg.density || 'comfortable')
          doc.setAttribute('lang', cfg.lang || initialLocale)
        } catch (e) {
          console.warn('Failed to restore appearance before paint:', e)
        }
      })()
    </script>
  </head>
  <body class={`min-h-screen flex flex-col bg-[var(--bg-base)] text-[var(--text-primary)] antialiased transition-colors selection:bg-[var(--selection)] ${fitViewport ? 'lg:h-screen lg:overflow-hidden' : ''}`}>
    <!-- API 降级提示条：占文档流置顶，滚动后 Header 照常吸顶，不遮挡任何控件 -->
    <DegradedBanner client:load initialLocale={locale} />

    <!-- Navigation Header -->
    <Header siteName={siteInfo.siteName} locale={locale} />

    <!-- Main Page Content -->
    <main class={`flex-1 w-full max-w-5xl mx-auto px-4 sm:px-6 ${fitViewport ? 'py-3 lg:py-4 flex flex-col min-h-0 overflow-hidden' : 'py-8'}`}>
      <slot />
    </main>

    <!-- Site Footer -->
    <Footer siteInfo={siteInfo} locale={locale} compact={fitViewport} />


    <!-- Interactive Client Modals/Drawers：非首屏交互，浏览器空闲后再水合 -->
    <AppearanceDrawer client:idle initialLocale={locale} />
    <SearchModal client:idle initialLocale={locale} />
  </body>
</html>
