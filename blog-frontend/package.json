{
  "name": "blog-frontend",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy --config dist/server/wrangler.json",
    "deploy:check": "astro build && wrangler deploy --dry-run --config dist/server/wrangler.json",
    "deploy:pages": "astro build && wrangler deploy --config dist/server/wrangler.json",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "node scripts/agents-lint.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.0",
    "@astrojs/react": "^6.0.5",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.1",
    "chart.js": "^4.5.1",
    "katex": "^0.18.5",
    "lucide-react": "^1.40.0",
    "markdown-it": "^15.0.1",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-ruby": "^1.1.2",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.17.2",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "vitest": "^5.0.0"
  }
}
